{
  "name": "monday-mcp",
  "version": "1.0.0",
  "description": "Sistema de visualização, previsão e notificação de recarga de saldo Meta Ads integrado com Monday.com e MCP",
  "main": "dist/backend/server.js",
  "type": "module",
  "scripts": {
    "dev:backend": "tsx watch src/backend/server.ts",
    "dev:mcp": "tsx src/mcp/server.ts",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:backend": "tsc -p tsconfig.server.json",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "deploy": "npm run build:frontend && npx gh-pages -d frontend/dist -b gh-pages --nojekyll",
    "start": "node dist/backend/server.js"
  },
  "keywords": [
    "monday",
    "mcp",
    "meta-ads",
    "traffic-management",
    "calendar",
    "kanban"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.4",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^18.0.0",
    "fastify": "^5.12.5",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.10",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
