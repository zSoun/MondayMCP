# Porta da API do Servidor
PORT=3001
HOST=0.0.0.0

# Monday.com API
# Obtenha em: https://<sua-conta>.monday.com/apps/manage/tokens
MONDAY_API_KEY=
# ID do Quadro (será preenchido automaticamente ao clicar no botão "Criar Quadro no Monday" ou adicione manualmente)
MONDAY_BOARD_ID=

# Configuração de Alerta de Saldo
# Disparar alerta quando faltar X dias ou menos para esgotar o saldo
ALERT_THRESHOLD_DAYS=2

# Configuração de E-mail (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app-ou-token
SMTP_FROM="Alerta de Saldo Meta Ads <seu-email@gmail.com>"

# Lista de E-mails da Equipe Unificada (separados por vírgula)
# O gestor e os 2 colaboradores receberão todos os alertas
TEAM_EMAILS=gestor@exemplo.com,colaborador1@exemplo.com,colaborador2@exemplo.com

# Google Calendar (Opcional - caso queira criar eventos via API direta)
# Se não preenchido, os 3 podem simplesmente assinar o link do Feed iCal (.ics) gerado pela aplicação!
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
